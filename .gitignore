# Terraform / Terragrunt working files
.terraform/
.terragrunt-cache/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
# Local state used by TG_MOCK_AWS=true plans
live/.mock-state/
# Files generated by Terragrunt into each unit
backend.tf
provider.tf
# Modules are libraries: lock files belong to the root units, not to modules
modules/**/.terraform.lock.hcl

# Editor / local tooling (may contain personal account data)
.vscode/
.idea/
.DS_Store
